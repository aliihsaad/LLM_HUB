# Server encryption key for API key storage (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-key-here

# Server port (default: 3001)
PORT=3001

# Context7 API Configuration (optional — for live provider documentation updates)
# Get your API key from https://context7.ai
# CONTEXT7_API_URL=https://api.context7.com/v1
# CONTEXT7_API_KEY=your-context7-api-key
